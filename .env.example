# sagp — example environment. Copy to `.env` for local dev; NEVER commit `.env`.
#
# Only SAGP_-prefixed keys are read by Settings (config.py), and unknown SAGP_
# keys refuse to boot (invariant 12). Upstream keys (HF_*, OLLAMA_*, TLDEXTRACT_*)
# are exported by bin/sagp-serve BEFORE the interpreter starts — do not put them
# here. Secrets below are generated into `.env` by scripts/provision/09_secrets.py
# at M1; leave them unset in dev.

# --- profile ---
SAGP_ENV=dev
SAGP_GUARD=enforce

# --- model / backend selection ---
SAGP_LLM_MODEL=llama3.2:3b-instruct-q4_K_M
SAGP_SPACY_MODEL=en_core_web_md
SAGP_QDRANT_MODE=embedded
SAGP_REHYDRATE_OUTPUT=0

# --- caps (BLUEPRINT §12) ---
SAGP_MAX_INPUT_CHARS=8000
SAGP_MAX_SCAN_UNIT_CHARS=20000
SAGP_MAX_DOC_BYTES=52428800
SAGP_MAX_WINDOWS=16
SAGP_MAX_CTX_CHARS=7000
SAGP_MAX_VAULT_ENTRIES=2000

# --- timeouts (BLUEPRINT §12) ---
SAGP_TIMEOUT_INJECTION_MS=2000
SAGP_TIMEOUT_PII_MS=3000
SAGP_TIMEOUT_EMBED_MS=2000
SAGP_TIMEOUT_RETRIEVE_MS=3000
SAGP_TIMEOUT_LLM_S=120
SAGP_TIMEOUT_REQUEST_S=180
SAGP_REJECTION_DEADLINE_MS=120

# --- paths (relative to repo root) ---
SAGP_DATA_DIR=data
SAGP_MODELS_DIR=models
SAGP_AUDIT_DIR=audit
SAGP_CONFIG_DIR=config

# --- secrets (generated at M1; leave unset in dev) ---
# SAGP_API_TOKEN=
# SAGP_API_TOKEN_REVEAL=
# SAGP_AUDIT_HMAC_KEY=
# SAGP_PII_PEPPER=
